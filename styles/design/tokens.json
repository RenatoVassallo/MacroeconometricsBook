{
  "$meta": {
    "name": "Warm Folio",
    "for": "Applied Macroeconometrics with Python — Quarto book (HTML + LuaLaTeX PDF) and matplotlib figures",
    "version": "1.0.0",
    "date": "2026-09-17",
    "theme": "light only; no dark theme shipped (see handoff/HANDOFF.md §6)",
    "units": { "web": "px unless noted", "print": "pt unless noted" }
  },

  "color": {
    "text":        { "hex": "#2A231D", "contrast_on_bg": 13.1 },
    "text_muted":  { "hex": "#6B5F52", "contrast_on_bg": 5.5 },
    "bg":          { "hex": "#FDFBF7" },
    "surface":     { "hex": "#F7EDE5" },
    "surface_2":   { "hex": "#F0E0D6" },
    "surface_code":{ "hex": "#FBF6F1" },
    "border":      { "hex": "#DED0C4", "contrast_on_bg": 3.1 },
    "border_soft": { "hex": "#E7DAD0" },
    "primary":     { "hex": "#B0472A", "contrast_on_bg": 5.7 },
    "primary_dark":{ "hex": "#8E3620", "contrast_on_bg": 7.4 },
    "accent":      { "hex": "#4E6E38", "contrast_on_bg": 4.8, "contrast_on_surface": 4.65 },
    "info":        { "hex": "#3D647F", "contrast_on_bg": 6.4 },
    "link":        { "hex": "#B0472A" },
    "link_hover":  { "hex": "#8E3620" }
  },

  "color_block": {
    "definition":  "#2A231D",
    "assumption":  "#B0472A",
    "result":      "#2A231D",
    "algorithm":   "#6B5F52",
    "application": "#3D647F",
    "intuition":   "#4E6E38",
    "pitfall":     "#8E3620",
    "exercise":    "#6B5F52"
  },

  "chart": {
    "observed":   ["#2A231D", "#6B5F52", "#9A9086"],
    "estimate":   ["#B0472A", "#8E3620"],
    "realized":   "#1F3D5C",
    "band":       ["#F4DCD1", "#E6BCA8", "#D4907A", "#BF6244"],
    "band_order": "index 0 = outermost (95%), 3 = innermost (68%)",
    "shock":      ["#2A231D", "#3D647F", "#B0472A", "#5A7D43", "#9A7B2E", "#C9A98A"],
    "shock_linestyle": ["-", "--", "-.", ":", [0, [6, 2]], "-"],
    "shock_marker":    ["o", "s", "^", "D", "v", "o"],
    "diverging":  ["#8E3620", "#C06A4A", "#E2AC93", "#F0E0D6", "#9DB6C6", "#5B87A3", "#23435A"],
    "diverging_center": "#F0E0D6",
    "episode": { "recession": "#EDE9E4", "forecast": "#FBF0EA" },
    "grid":   "#E7DAD0",
    "spine":  "#6B5F52",
    "zero_line": "#2A231D"
  },

  "font": {
    "body":  { "family": "EB Garamond",   "license": "SIL OFL 1.1", "web": "Google Fonts / self-host woff2", "files": "EBGaramond[wght].ttf, EBGaramond-Italic[wght].ttf" },
    "math":  { "family": "Garamond-Math", "license": "SIL OFL 1.1", "web": "self-host + KaTeX/MathJax fallback", "files": "Garamond-Math.otf" },
    "ui":    { "family": "Source Sans 3", "license": "SIL OFL 1.1", "web": "Google Fonts / self-host woff2", "files": "SourceSans3[wght].ttf" },
    "mono":  { "family": "JetBrains Mono","license": "SIL OFL 1.1", "web": "Google Fonts / self-host woff2", "files": "JetBrainsMono[wght].ttf" },
    "figure_labels": { "family": "Source Sans 3", "note": "figures use the UI face, not the body serif" }
  },

  "type_web": {
    "root": 17,
    "body":        { "size": 17,   "line": 27.5, "weight": 400 },
    "h1":          { "size": 38,   "line": 44,   "weight": 600, "tracking": "-0.012em" },
    "h2":          { "size": 27,   "line": 33,   "weight": 600 },
    "h3":          { "size": 20,   "line": 27,   "weight": 600 },
    "h4_runin":    { "size": 17,   "weight": 700, "tracking": "0.12em", "transform": "uppercase" },
    "block_label": { "size": 11.5, "weight": 700, "tracking": "0.13em", "transform": "uppercase" },
    "math_display":{ "size": 19,   "line": 28.5 },
    "code":        { "size": 13.5, "line": 22 },
    "caption":     { "size": 12.5, "line": 19 },
    "margin_note": { "size": 12,   "line": 18.5 }
  },

  "type_print": {
    "trim": "7in x 10in",
    "body":        { "size": 10.5, "line": 14.5 },
    "h1":          { "size": 26,   "line": 29,  "weight": 600 },
    "h2":          { "size": 14,   "line": 17,  "weight": 600 },
    "h3":          { "size": 11.5, "weight": 600 },
    "h4_runin":    { "size": 10.5, "transform": "uppercase" },
    "block_label": { "size": 8.5,  "transform": "uppercase" },
    "math_display":{ "size": 10.5, "line": 15.2 },
    "code":        { "size": 8.5,  "line": 11 },
    "caption":     { "size": 9,    "line": 12 },
    "margin_note": { "size": 8,    "line": 10.5 },
    "running_head":{ "size": 9.5,  "tracking": "0.1em", "transform": "uppercase" },
    "figure_text": { "size": 8.5,  "range": "8 to 9 pt" }
  },

  "layout": {
    "measure_ch": 68,
    "measure_max_rem": 40,
    "web": { "content": 640, "margin_column": 200, "margin_gap": 32, "sidebar": 270, "toc": 240 },
    "print": {
      "text_block": "4.5in x 7.6in",
      "margin_top": "0.9in",
      "margin_inner": "0.85in",
      "margin_outer": "1.65in",
      "margin_foot": "1.0in",
      "margin_column": "1.15in",
      "margin_gutter": "0.3in"
    },
    "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
    "space_print_pt": { "1": 3, "2": 6, "3": 9, "4": 12, "5": 18, "6": 24, "7": 36, "8": 48 },
    "figure_width": {
      "text":   { "web": 640, "print": "4.5in" },
      "margin": { "web": 200, "print": "1.15in" },
      "full":   { "web": 960, "print": "6.0in" }
    }
  },

  "code_tokens": {
    "keyword":  { "hex": "#9E3F26", "weight": 600 },
    "function": { "hex": "#2A231D", "weight": 600 },
    "builtin":  { "hex": "#7E6325" },
    "string":   { "hex": "#4E6E38" },
    "number":   { "hex": "#3D647F" },
    "comment":  { "hex": "#857A6D", "style": "italic" },
    "operator": { "hex": "#2A231D" },
    "cell_bg":  { "hex": "#FBF6F1" },
    "cell_border": { "hex": "#E7DAD0" },
    "output_text": { "hex": "#4A423B" },
    "output_rule": { "hex": "#DED0C4", "width": 2 },
    "inline_bg": { "hex": "#F4EAE2" }
  },

  "figure_style": {
    "facecolor": "white",
    "savefig_facecolor": "white",
    "spines": { "top": false, "right": false, "left": true, "bottom": true },
    "grid": { "axis": "y", "color": "#E7DAD0", "linewidth": 0.5 },
    "legend": { "frameon": false },
    "titles_inside": false,
    "dpi_savefig": 300,
    "line_width": 1.1,
    "band_alpha": 1.0
  }
}
